[Unit]
Description=mail-bot (Trail Guide) Telegram assistant
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/owentaylor/projects/mail-bot
ExecStart=/home/owentaylor/projects/mail-bot/.venv/bin/python main.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
